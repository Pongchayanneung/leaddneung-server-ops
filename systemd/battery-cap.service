# /etc/systemd/system/battery-cap.service
[Unit]
Description=Cap battery charge at 60% (slows calendar aging; 67.5% health as of 2026-08-08)
After=multi-user.target
[Service]
Type=oneshot
ExecStart=/bin/bash -c 'for f in /sys/class/power_supply/BAT*/charge_control_end_threshold; do [ -w "$f" ] && echo 60 > "$f"; done'
[Install]
WantedBy=multi-user.target
